{
  "version": "0.2.0",
  "configurations": [
    {
        "name": "Launch Firefox against localhost",
        "type": "firefox",
        "request": "launch",
        "reAttach": true,
        "url": "https://localhost",
        "webRoot": "${workspaceFolder}/public",
        "pathMappings": [
            {
                "url": "webpack:///./",
                "path": "${workspaceFolder}/"
            }
        ]
      }
  ]
}
