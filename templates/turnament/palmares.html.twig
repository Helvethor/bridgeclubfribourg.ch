{% extends 'base.html.twig' %}


{% block title %}
	Palmarès
{% endblock %}


{% block content %}
	
<h1>Palmarès</h1>
<h2>Saison {{ fromYear }}&nbsp;-&nbsp;{{ toYear }} - Tournois du {{ dow | frenchDow }}</h2>

<div class='padded-content'>

	<div class='print-hidden'>

		<div class='row gy-3 mb-4'>
			<div class='col-12 col-sm-6 col-md-4 form-group'>
				<label for='fromYearSelect' class='form-label'>Saison</label>
				<select id='fromYearSelect' class='form-control select-redirect'>

					{% for year in range(2015, actualYear ) %}
							<option value='{{
								path(
									'turnament_palmares',
									{
										'fromYear': year,
										'dow': dow
									}
								)
							}}'
							{% if year == fromYear %}selected='selected'{% endif %}>
								Saison {{ year }} - {{ year + 1 }}
							</option>
					{% endfor %}

				</select>
			</div>

			<div class='col-12 col-sm-6 col-md-4 form-group'>
				<label for='dowSelect' class='form-label'>Jour de la semaine</label>
				<select id='dowSelect' class='form-control select-redirect'>
							
					{% for selectDow in [ 
						'monday',
						'tuesday', 
						'wednesday', 
						'thursday', 
						'friday', 
						'saturday',
						'sunday' ]
					%}
						<option value='{{
							path(
								'turnament_palmares',
								{
									'fromYear': fromYear,
									'dow': selectDow
								}
							)
						}}'
						{% if dow == selectDow %}selected='selected'{% endif %}>
							Tournois du {{ selectDow | frenchDow }}
						</option>
					{% endfor %}

				</select>
			</div>
		</div>
	</div>

	{% if performances is empty %}
		<p>Aucun résultat n'est disponible sur cette page.</p>
	{% else %}

	{% if fromYear == 2015 %}
		<p>Les données concernants l'année 2015 - 2016 sont incomplètes. Par conséquent le classement ci-dessous n'est pas représentatif.</p>
	{% endif %}

	<div class='print-hidden mb-4'>
		{% include 'turnament/files.html.twig' %}
	</div>

	<div class='table-responsive'>
		<table class='table table-striped table-sortable'>

			<thead>

				<tr>
					<th>Rang</th>
					<th>N° FSB</th>
					<th>Nom</th>
					<th>Tournois joués</th>
					<th>Moyenne PV</th>
					<th>Total PV</th>
				</tr>

			</thead>

			<tbody>

				{% set rank = 1 %}
				{% for performance in performances %}
				{% if performance.pv > 0 %}
					<tr>
						<td>{{ rank }}</td>
						{% set rank = rank + 1 %}
						<td>{{ performance.person.fsbNice }}</td>
							{% include 'misc/table-btn.html.twig' with {
								'link': path('turnament_stats', {
									'fromYear': fromYear,
									'dow': dow,
									'fsb': performance.person.fsb
								}),
								'content': performance.person.fullName
							} %}
						<td>{{ performance.tCount }}</td>
						<td>{{ (performance.pv / performance.tCount) | number_format(2) }}</td>
						<td>{{ performance.pv }}</td>

					</tr>
				{% endif %}
				{% endfor %}

			</tbody>

		</table>
	</div>

	{% endif %}

</div>

{% endblock %}
