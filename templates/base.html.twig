<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
		<meta name='container-type' content='{% block type %}content{% endblock %}'>
        <title>{% block title %}{% endblock %} - Les Quatre Trèfles</title>
		
        <link rel="icon" type="image/x-icon" href="/favicon.ico"/>
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">

		{% block css %}
            <link href="{{ asset('build/app.css') }}" rel='stylesheet'/>
		{% endblock %}

    </head>
    <body>
		
		<div class='container-fluid'>

			{% block header %}
				{% include( 'header.html.twig' ) %}
			{% endblock %}
	
			{% block main %}
				{% include( 'main.html.twig' ) with 
					{
						content: block('content'), 
						type: block('type')
					} 
				%}
			{% endblock %}

			{% block footer %}
				{% include( 'footer.html.twig' ) %}
			{% endblock %}
	
	        {% block javascript %}
                <script src="{{ asset('build/runtime.js') }}" type='text/javascript'></script>
                <script src="{{ asset('build/app.js') }}" type='text/javascript'></script>
			{% endblock %}

		</div>

    </body>
</html>
