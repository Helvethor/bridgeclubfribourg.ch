{% extends 'base.html.twig' %}


{% block title %}
	Gestion des inscriptions
{% endblock %}

{% block content %}

<h1>{{ block('title') }}</h1>

<h2>Ouvrir des inscriptions</h2>

<div class='padded-content'>
    {% include 'admin/registrations.form.html.twig' with {'form': boardForm} %}
</div>

{% if boards is defined and boards | length > 0 %}
<h2>Modifier les inscriptions</h2>

<div class='padded-content'>

    <div class='table-responsive'>
    <table class='table table-striped dataTable'>
        <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>Heure</th>
                <th>Type</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for board in boards %}
            <tr>
                <td>{{ board.id }}</td>
                <td><a class='btn btn-table btn-outline-primary' href="{{ path('turnament_registrations', {
                        'day': board.date | date( 'd' ),
                        'month': board.date | date( 'm' ),
                        'year': board.date | date( 'Y' ),
                    }) }}">{{ board.date | date('Y/m/d') }}</a></td>
                <td>{{ board.time | date('H:i') }}</td>
                <td>
                    {% if board.searchOnly %}
                        Recherche de partenaires
                    {% else %}
                        Inscriptions ({{ board.registrations | length }})
                    {% endif %}
                </td>
                <td>
                    <div class='d-flex flex-wrap gap-1 justify-content-center'>
                        <form method='POST' action='{{ path('admin_registrations_modify', {
                            'id': board.id
                        }) }}'>
                            <input class='btn btn-table btn-outline-warning btn-outline-warn' type='submit' value='Modifier'>
                        </form>
                        <form method='POST' action='{{ path('admin_registrations_delete', {
                            'id': board.id
                        }) }}'>
                            <input class='btn btn-table btn-outline-danger' type='submit' value='Supprimer'>
                        </form>
                    </div>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endif %}

{% endblock %}
